#!/bin/bash

# ─────────────────────────────────────────────
# Arch Linux cleanup utility
# Usage: sudo cleanup
# ─────────────────────────────────────────────

if [[ $EUID -ne 0 ]]; then
    echo "Please run with sudo:"
    echo "  sudo cleanup"
    exit 1
fi

# Colors
BOLD="\033[1m"
GREEN="\033[32m"
CYAN="\033[36m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

ROOT_BEFORE=$(df -B1 / | awk 'NR==2 {print $4}')
START_TIME=$(date +%s)

section() {
    echo
    echo -e "${CYAN}${BOLD}━━━ $1 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
}

success() {
    echo -e "  ${GREEN}✓${RESET} $1"
}

echo
echo -e "${BOLD}╔══════════════════════════════════════════╗"
echo -e "║          ARCH SYSTEM CLEANUP             ║"
echo -e "╚══════════════════════════════════════════╝${RESET}"

# ── Pacman ──────────────────────────────────

section "Pacman cache"

if command -v paccache >/dev/null 2>&1; then
    paccache -r
    success "Old package versions removed"

    paccache -ruk0
    success "Cache for uninstalled packages removed"
else
    echo -e "  ${YELLOW}! paccache not installed${RESET}"
    echo "    Install with: sudo pacman -S pacman-contrib"
fi

rm -f /var/cache/pacman/pkg/*.part
success "Incomplete package downloads removed"

# ── Journal ─────────────────────────────────

section "System logs"

journalctl --vacuum-size=500M
success "Journal limited to 500 MB"

# ── Temporary files ─────────────────────────

section "Temporary files"

systemd-tmpfiles --clean
success "System temporary files cleaned"

# ── User cache ──────────────────────────────

section "User cache"

if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)

    if [[ -d "$USER_HOME/.cache" ]]; then
        rm -rf "$USER_HOME/.cache/"*
        success "$SUDO_USER cache cleared"
    else
        success "No user cache directory found"
    fi
else
    echo -e "  ${YELLOW}! Could not determine regular user${RESET}"
fi

# ── Results ─────────────────────────────────

ROOT_AFTER=$(df -B1 / | awk 'NR==2 {print $4}')
FREED=$((ROOT_AFTER - ROOT_BEFORE))
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

human_size() {
    numfmt --to=iec-i --suffix=B "$1"
}

section "Results"

if (( FREED > 0 )); then
    echo -e "  Space freed : ${GREEN}${BOLD}$(human_size "$FREED")${RESET}"
else
    echo -e "  Space freed : ${GREEN}0 B${RESET}"
fi

echo -e "  Free space  : ${BOLD}$(human_size "$ROOT_AFTER")${RESET}"
echo -e "  Time taken  : ${BOLD}${DURATION}s${RESET}"

echo
echo -e "${GREEN}${BOLD}✓ Cleanup complete.${RESET}"
echo
